{ InitWindow, CloseWindow, WindowShouldClose, SetTargetFPS,
  BeginDrawing, EndDrawing, ClearBackground, DrawText,
  RAYWHITE, DARKGRAY } :: import("./lib");

pragma(Pragma.AllowUnsafe);

main :: (fn() -> unit)({
  unsafe(InitWindow(i32(800), i32(450), "raylib_yo - Hello Raylib!"));
  unsafe(SetTargetFPS(i32(60)));

  while(!unsafe(WindowShouldClose()), {
    unsafe(BeginDrawing());
    unsafe(ClearBackground(RAYWHITE));
    unsafe(DrawText("Hello from Yo + Raylib!", i32(190), i32(200), i32(20), DARKGRAY));
    unsafe(EndDrawing());
  });

  unsafe(CloseWindow());
});

export(main);
